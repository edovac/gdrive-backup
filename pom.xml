<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>org.nm</groupId>
	<artifactId>gdrive-backup</artifactId>
	<version>${revision}</version>
	<name />
	<description />
	<url />
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer />
	</developers>
	<scm>
		<connection />
		<developerConnection />
		<tag />
		<url />
	</scm>
	<properties>
		<java.version>25</java.version>
		<javafx.version>27</javafx.version>
		<mockito.version>5.24.0</mockito.version>
		<license-maven-plugin.version>2.7.1</license-maven-plugin.version>
		<!--
			The project version, which the release workflow sets from the tag (-Drevision=1.2.0 or
			-Drevision=1.2.0-rc.1). It feeds the jar manifest (Spring's startup log) and build-info (the UI
			header); the windows-package profile derives the numeric part jpackage needs from it. The jar is
			never installed or deployed, so ${revision} needs no flattening.
		-->
		<revision>0.0.1-SNAPSHOT</revision>
		<google-http-client.version>2.2.0</google-http-client.version>
		<google-oauth-client.version>1.39.0</google-oauth-client.version>
		<google-auth-library.version>1.54.0</google-auth-library.version>
		<guava.version>33.7.2-jre</guava.version>
	</properties>
	<!--
		google-api-client drags in older google-http-client, google-oauth-client and
		google-auth-library-credentials versions, which would otherwise win over the newer
		siblings declared below; pin each family to one version. It also drags in Guava 33.1,
		whose AbstractFuture calls the deprecated sun.misc.Unsafe and logs a warning at startup.
	-->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.google.http-client</groupId>
				<artifactId>google-http-client-bom</artifactId>
				<version>${google-http-client.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.google.auth</groupId>
				<artifactId>google-auth-library-bom</artifactId>
				<version>${google-auth-library.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava-bom</artifactId>
				<version>${guava.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.google.oauth-client</groupId>
				<artifactId>google-oauth-client</artifactId>
				<version>${google-oauth-client.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-graphics</artifactId>
			<version>${javafx.version}</version>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-base</artifactId>
			<version>${javafx.version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.api-client</groupId>
			<artifactId>google-api-client</artifactId>
			<version>2.9.1</version>
		</dependency>
		<dependency>
			<groupId>com.google.oauth-client</groupId>
			<artifactId>google-oauth-client-jetty</artifactId>
			<version>${google-oauth-client.version}</version>
		</dependency>
		<dependency>
			<groupId>com.google.http-client</groupId>
			<artifactId>google-http-client-gson</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.auth</groupId>
			<artifactId>google-auth-library-oauth2-http</artifactId>
		</dependency>
		<dependency>
			<groupId>com.google.apis</groupId>
			<artifactId>google-api-services-drive</artifactId>
			<version>v3-rev20260916-2.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.google.apis</groupId>
			<artifactId>google-api-services-admin-directory</artifactId>
			<version>directory_v1-rev20260914-2.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.google.apis</groupId>
			<artifactId>google-api-services-admin-reports</artifactId>
			<version>reports_v1-rev20260823-2.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.google.apis</groupId>
			<artifactId>google-api-services-serviceusage</artifactId>
			<version>v1-rev20260921-2.0.0</version>
		</dependency>
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>3.53.4.0</version>
		</dependency>
		<dependency>
			<groupId>com.microsoft</groupId>
			<artifactId>credential-secure-storage</artifactId>
			<version>1.0.3</version>
		</dependency>

		<!-- Brings mockito-core at ${mockito.version}, which also names the Surefire/Failsafe javaagent jar. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.5.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!--
						JNA (via credential-secure-storage, for Windows Credential Manager) calls
						System.load; without this flag the JDK warns about a restricted method and
						will block it in a future release. The jpackage launcher passes the same flag.
					-->
					<jvmArguments>--enable-native-access=ALL-UNNAMED</jvmArguments>
				</configuration>
				<executions>
					<execution>
						<!--
							Writes META-INF/build-info.properties so Spring's ProjectInfoAutoConfiguration
							exposes a BuildProperties bean at runtime (the app version and build time in the UI).
						-->
						<id>build-info</id>
						<goals>
							<goal>build-info</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!--
				License gate, run by `verify` (and so by CI): every runtime dependency must declare a license
				from the list below. A new dependency under any other license, or under none, fails the build
				until someone reviews it and either adds the license here or drops the dependency. The list is
				also what THIRD-PARTY-NOTICES.md documents; keep the two in step.
			-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>license-maven-plugin</artifactId>
				<version>${license-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>check-third-party-licenses</id>
						<phase>verify</phase>
						<goals>
							<goal>add-third-party</goal>
						</goals>
						<configuration>
							<includedScopes>compile,runtime</includedScopes>
							<outputDirectory>${project.build.directory}/licenses</outputDirectory>
							<failOnMissing>true</failOnMissing>
							<failOnBlacklist>true</failOnBlacklist>
							<!-- The same license is spelled differently from one POM to the next. -->
							<licenseMerges>
								<licenseMerge>Apache-2.0|The Apache Software License, Version 2.0|Apache License, Version 2.0|The Apache License, Version 2.0|Apache 2.0</licenseMerge>
								<licenseMerge>MIT|MIT License</licenseMerge>
								<licenseMerge>BSD-3-Clause|BSD New license</licenseMerge>
								<licenseMerge>EPL-2.0|EPL 2.0</licenseMerge>
								<licenseMerge>GPL-2.0 with Classpath Exception|GPL2 w/ CPE|GPLv2+CE</licenseMerge>
							</licenseMerges>
							<!--
								Dual-licensed libraries list every option, so each option has to be here:
								JNA (Apache-2.0 or LGPL-2.1+), Logback (EPL-2.0 or LGPL-2.1), Jakarta
								Annotations (EPL-2.0 or GPL-2.0 with the Classpath Exception), plus JavaFX
								(GPL-2.0 with the Classpath Exception). Plain GPL, AGPL and unlisted licenses are not.
							-->
							<includedLicenses>
								<includedLicense>Apache-2.0</includedLicense>
								<includedLicense>MIT</includedLicense>
								<includedLicense>BSD-3-Clause</includedLicense>
								<includedLicense>EPL-2.0</includedLicense>
								<includedLicense>LGPL-2.1-or-later</includedLicense>
								<includedLicense>LGPL-2.1-only</includedLicense>
								<includedLicense>GPL-2.0 with Classpath Exception</includedLicense>
							</includedLicenses>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.springframework.boot</groupId>
									<artifactId>spring-boot-configuration-processor</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
					<includes>
						<include>**/*Test.java</include>
					</includes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
					<includes>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Windows-only: builds an MSI installer with a bundled JRE via jpackage. Scoped to this OS
			profile so `./mvnw verify` on the Linux CI job never touches it; jpackage doesn't
			cross-compile, it bundles the host's own JRE/natives, so this can only run on Windows.
		-->
		<profile>
			<id>windows-package</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<build>
				<plugins>
					<!--
						jpackage copies the launcher .exe from the JDK with its read-only attribute,
						which `clean` otherwise refuses to delete on the next build.
					-->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-clean-plugin</artifactId>
						<configuration>
							<force>true</force>
						</configuration>
					</plugin>
					<!--
						jpackage accepts only a plain dotted numeric version (it becomes the .exe's file
						version), so drop any qualifier: 1.2.0-rc.1 and 0.0.1-SNAPSHOT become 1.2.0 and 0.0.1.
					-->
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>build-helper-maven-plugin</artifactId>
						<version>3.6.2</version>
						<executions>
							<execution>
								<id>jpackage-version</id>
								<phase>validate</phase>
								<goals>
									<goal>regex-property</goal>
								</goals>
								<configuration>
									<name>jpackage.version</name>
									<value>${project.version}</value>
									<regex>-.*$</regex>
									<replacement />
									<failIfNoMatch>false</failIfNoMatch>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<!--
						jpackage's input directory (the "input" option below) is copied wholesale into
						the app image, so stage just the repackaged Spring Boot fat jar here rather than
						pointing it at the whole (much larger, mostly irrelevant) target/ directory.
					-->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>stage-jpackage-input</id>
								<phase>package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
									<resources>
										<resource>
											<directory>${project.build.directory}</directory>
											<includes>
												<include>${project.build.finalName}.jar</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<!--
						javafx-controls/-graphics/-base depend (via each artifact's own OS-activated
						pom profile) on a same-named Windows-classified artifact that carries the real
						module-info.class; the unclassified jar has none. jlink needs the classified
						jars on an explicit module path; pointing it at BOOT-INF/lib (which has both)
						makes it ambiguous which one provides "javafx.base" and jlink fails to resolve
						the module at all. So stage only the classified jars into their own directory.
					-->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<executions>
							<execution>
								<id>stage-javafx-modules</id>
								<phase>package</phase>
								<goals>
									<goal>copy</goal>
								</goals>
								<configuration>
									<artifactItems>
										<artifactItem>
											<groupId>org.openjfx</groupId>
											<artifactId>javafx-base</artifactId>
											<version>${javafx.version}</version>
											<classifier>win</classifier>
										</artifactItem>
										<artifactItem>
											<groupId>org.openjfx</groupId>
											<artifactId>javafx-graphics</artifactId>
											<version>${javafx.version}</version>
											<classifier>win</classifier>
										</artifactItem>
										<artifactItem>
											<groupId>org.openjfx</groupId>
											<artifactId>javafx-controls</artifactId>
											<version>${javafx.version}</version>
											<classifier>win</classifier>
										</artifactItem>
									</artifactItems>
									<outputDirectory>${project.build.directory}/jpackage-modules</outputDirectory>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<version>1.8.0</version>
						<executions>
							<execution>
								<id>jpackage-windows-app-image</id>
								<!-- Runs after spring-boot:repackage and the two staging steps above, all also bound to package. -->
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<!--
										A self-contained folder (native .exe launcher + bundled trimmed
										JRE), not an installer: no WiX/Inno Setup dependency needed to
										build one. Distribute by zipping this directory.
									-->
									<type>APP_IMAGE</type>
									<name>Google Drive Backup</name>
									<!-- The numeric part of project.version, derived by build-helper above. -->
									<appVersion>${jpackage.version}</appVersion>
									<vendor>gdrive-backup</vendor>
									<description>Personal Google Drive backup tool</description>
									<!-- Embedded in the launcher .exe; generated by tools/GenerateAppIcon.java. -->
									<icon>${project.basedir}/src/main/packaging/windows/gdrive-backup.ico</icon>
									<input>${project.build.directory}/jpackage-input</input>
									<mainJar>${project.build.finalName}.jar</mainJar>
									<destination>${project.build.directory}/app-image</destination>
									<modulePaths>
										<modulePath>${project.build.directory}/jpackage-modules</modulePath>
									</modulePaths>
									<!--
										Native access lets JNA load its native library; see
										spring-boot-maven-plugin above. The windowed launcher has no
										console, so the profile switches logback-spring.xml to rolling
										files in the log folder beside the .exe ($ROOTDIR).
									-->
									<javaOptions>
										<option>--enable-native-access=ALL-UNNAMED</option>
										<option>-Dspring.profiles.active=windows-package</option>
										<option>-Dlogging.file.path=$ROOTDIR/log</option>
									</javaOptions>
									<!--
										Computed by running jdeps' "print module deps" mode (multi release
										25, ignoring missing deps) against BOOT-INF/classes of the exploded
										fat jar (jdeps can't see into a Spring Boot fat jar's nested
										BOOT-INF/lib directly), classpath set to BOOT-INF/lib's jars minus
										the OS-unclassified javafx-* duplicates (they carry no module-info
										and confuse jdeps's module attribution when both the classified and
										unclassified jars are on the classpath together). That result is
										unioned with two kinds of module jdeps cannot find by static
										analysis alone: javafx.base/controls/graphics (loaded via the
										JavaFX runtime, not a bytecode "requires" jdeps' classpath mode
										attributes to a named module) and jdk.crypto.ec (the EC/ECDSA TLS
										cipher suites Google's APIs need over HTTPS, selected reflectively
										via the security provider SPI, not a direct class reference).
									-->
									<addModules>
										<addModule>java.base</addModule>
										<addModule>java.compiler</addModule>
										<addModule>java.desktop</addModule>
										<addModule>java.instrument</addModule>
										<addModule>java.logging</addModule>
										<addModule>java.management</addModule>
										<addModule>java.naming</addModule>
										<addModule>java.prefs</addModule>
										<addModule>java.scripting</addModule>
										<addModule>java.security.jgss</addModule>
										<addModule>java.sql</addModule>
										<addModule>javafx.base</addModule>
										<addModule>javafx.controls</addModule>
										<addModule>javafx.graphics</addModule>
										<addModule>jdk.crypto.ec</addModule>
										<addModule>jdk.httpserver</addModule>
										<addModule>jdk.jfr</addModule>
										<addModule>jdk.unsupported</addModule>
									</addModules>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>